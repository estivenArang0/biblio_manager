# Configuración del API local.
# Copia este archivo como .env si necesitas cambiar los valores por defecto.

# Puerto del backend (Vite le hace proxy desde /api).
PORT=4000

# Ruta alternativa de la base SQLite. Por defecto: server/data/biblio.db
# BIBLIO_DB=./server/data/biblio.db

# Contraseña inicial de los usuarios demo. Solo se usa al sembrar la base.
# Déjala vacía para usar la del seed (ver README).
DEMO_PASSWORD=

# Minutos de inactividad antes de invalidar la sesión en el servidor.
SESSION_IDLE_MINUTES=30
