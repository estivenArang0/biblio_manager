# Configuración del proyecto web de Firebase.
# 1. Copia este archivo como .env  (cp .env.example .env)
# 2. Rellena los valores desde la consola de Firebase:
#    Configuración del proyecto > Tus apps > Configuración del SDK
# Nota: la configuración web de Firebase es pública; la seguridad real
# se define con las reglas de Firestore (firestore.rules).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
